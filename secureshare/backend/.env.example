NODE_ENV=development
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://secureshare:dev_only_change_me@localhost:5432/secureshare?schema=public
TRANSFER_LOOKUP_SECRET=replace-with-at-least-32-random-bytes
OPAQUE_SERVER_SETUP=
STORAGE_DRIVER=local
PRIVATE_STORAGE_DIR=../../.private-storage

# For private S3-compatible storage, set STORAGE_DRIVER=s3 and configure the
# standard AWS SDK environment variables. Never put these values in frontend code.
S3_BUCKET=secureshare-files
S3_REGION=us-east-1
