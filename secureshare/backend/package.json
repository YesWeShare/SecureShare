{
  "name": "secureshare-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:dev": "pglite-server --db=.dev-db --port=5433 --host=127.0.0.1",
    "opaque:setup": "node scripts/create-opaque-setup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.11.1",
    "@serenity-kit/opaque": "^1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@nestjs/core@11.2.9": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "lodash": "^4.18.1",
    "multer": "^2.5.0"
  }
}
